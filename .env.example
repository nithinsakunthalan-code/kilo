# Copy to .env for local development. NEVER commit the real .env file.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-kilo.onrender.com

# SQL database (leave empty locally to use SQLite). Production example:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# MongoDB for chat logs + feedback, e.g. a free MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kilo_assistant

# Optional: LLM used to phrase answers from the FAQ. Without it the assistant answers straight from the FAQ.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Third-party food lookup (Open Food Facts needs no key); time limit in seconds
# FOOD_API_TIMEOUT_SECONDS=3